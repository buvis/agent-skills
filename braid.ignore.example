# Copy to ~/.agents/braid.ignore and edit.
#
# One skill name per line, matched exactly against the skill directory name.
# No globs, no regex. Blank lines are skipped; everything from a # to the end
# of the line is stripped. Listed names are never linked into
# $CLAUDE_ROOT/skills.
#
# This file is policy, not an error list. The usual reason to ignore a name is
# that the host already gets that skill from a plugin, and linking a standalone
# copy beside it creates a duplicate unnamespaced command.

# Skills a plugin already provides on the target host.
# catchup
# resolve-git-conflicts
# watch-ci

# Forks that inspect one host's own config or transcript store, so they have
# no valid projection to a different host.
# audit-codex-config

# Workflows a plugin has superseded or consolidated.
# audit-hooks
