+def notify_result(result: CommandResult, notify: Callable[..., None]) -> None:
+    """Forward a CommandResult's warnings and outcome to a notify callback.
+
+    Args:
+        result: Command outcome to report.
+        notify: Callback invoked as notify(message, severity=...).
+    """
+    for warning in result.warnings:
+        notify(warning, severity="warning")
+    if result.success:
+        if result.output:
+            notify(result.output, severity="information")
+    else:
+        notify(result.error or "Failed", severity="error")
