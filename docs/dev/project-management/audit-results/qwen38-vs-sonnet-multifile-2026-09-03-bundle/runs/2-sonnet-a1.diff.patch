+class TestNotifyResult:
+    def test_success_notifies_output_as_information(self) -> None:
+        notify = MagicMock()
+        result = CommandResult(success=True, output="done")
+
+        notify_result(result, notify)
+
+        notify.assert_called_once_with("done", severity="information")
+
+    def test_success_with_empty_output_notifies_nothing(self) -> None:
+        notify = MagicMock()
+        result = CommandResult(success=True, output="")
+
+        notify_result(result, notify)
+
+        notify.assert_not_called()
+
+    def test_failure_notifies_error(self) -> None:
+        notify = MagicMock()
+        result = CommandResult(success=False, error="boom")
+
+        notify_result(result, notify)
+
+        notify.assert_called_once_with("boom", severity="error")
+
+    def test_failure_without_error_notifies_failed_fallback(self) -> None:
+        notify = MagicMock()
+        result = CommandResult(success=False, error="")
+
+        notify_result(result, notify)
+
+        notify.assert_called_once_with("Failed", severity="error")
+
+    def test_warnings_notified_before_success_output(self) -> None:
+        notify = MagicMock()
+        result = CommandResult(success=True, output="done", warnings=["w1", "w2"])
+
+        notify_result(result, notify)
+
+        assert notify.call_args_list == [
+            (("w1",), {"severity": "warning"}),
+            (("w2",), {"severity": "warning"}),
+            (("done",), {"severity": "information"}),
+        ]
+
+    def test_warnings_notified_before_failure_message(self) -> None:
+        notify = MagicMock()
+        result = CommandResult(success=False, error="boom", warnings=["w1"])
+
+        notify_result(result, notify)
+
+        assert notify.call_args_list == [
+            (("w1",), {"severity": "warning"}),
+            (("boom",), {"severity": "error"}),
+        ]
+
