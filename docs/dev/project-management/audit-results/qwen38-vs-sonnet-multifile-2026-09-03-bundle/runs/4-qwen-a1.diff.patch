+    def test_promote_records_raw_source_sha_replacing_pending_triage_row(
+        self,
+        settings: DocSettings,
+        registry_path: Path,
+        lock_path: Path,
+        state_db: StateDB,
+        mocker: MockerFixture,
+    ) -> None:
+        """Promote must record the filed row under the raw source sha.
+
+        The pipeline stamps a ``pending-triage`` row under the raw source sha
+        when it parks a document in ``_triage/``. Promote retires that row by
+        recording the filed row under the same sha (``INSERT OR REPLACE``), so
+        re-ingesting the same source PDF after promote is detected as a
+        duplicate and no second archive copy is filed.
+        """
+        triage_dir = settings.paths.business_root / "_triage"
+        pdf, yml = _stage_triage_pair(triage_dir, "20210311083422-cez-as-7102105594.invoice")
+        sha = hashlib.sha256(pdf.read_bytes()).hexdigest()
+
+        # Simulate the pipeline's triage stamp for this source document.
+        state_db.record_processed(
+            ProcessedRow(
+                sha256=sha,
+                canonical_filename="_triage/20210311083422-cez-as-7102105594.invoice.pdf (pending review)",
+                issuer_slug="cez-as",
+                doc_type="invoice",
+                processed_at=datetime.now(timezone.utc),
+                extraction_method="pending-triage",
+            )
+        )
+
+        write_proposal(yml, _build_proposal(sha256=sha, triage_pdf=pdf))
+
+        cmd, _ = _build_command(
+            settings=settings,
+            registry_path=registry_path,
+            lock_path=lock_path,
+            state_db=state_db,
+            proposal_yml=yml,
+            mocker=mocker,
+            ocr_pdf=pdf,
+        )
+
+        result = cmd.execute()
+        assert result.success is True
+
+        # Re-ingest of the same source is a duplicate: the row keyed by the
+        # raw source sha now carries the filed document's attributes.
+        dedup = state_db.dedup(sha)
+        assert dedup.is_duplicate is True
+        assert dedup.existing_row is not None
+        expected_filed = ProcessedRow(
+            sha256=sha,
+            canonical_filename=result.metadata["canonical_filename"],
+            issuer_slug="cez-as",
+            doc_type="invoice",
+            processed_at=datetime.now(timezone.utc),
+            extraction_method="manual",
+        )
+        assert dedup.existing_row.model_dump(exclude={"sha256", "processed_at"}) == expected_filed.model_dump(
+            exclude={"sha256", "processed_at"}
+        )
+
