+/// Upper bound on frontmatter byte size. Frontmatter beyond this is rejected
+/// as a parse error so an oversized synced file degrades into the existing
+/// lenient skip path instead of an unbounded parse.
+pub const MAX_FRONTMATTER_BYTES: usize = 256 * 1024;
+
 /// Parse YAML frontmatter string into DoogatMeta.
 /// Falls back to filename-based ID when `id` field is missing.
 pub fn parse_frontmatter(yaml: &str, path: &str) -> Result<DoogatMeta> {
+    if yaml.len() > MAX_FRONTMATTER_BYTES {
+        return Err(DoogatError::Yaml(format!(
+            "frontmatter is {} bytes, exceeding the {MAX_FRONTMATTER_BYTES}-byte cap",
+            yaml.len()
+        )));
+    }
     let raw: RawDoogatMeta = if yaml.trim().is_empty() {
         RawDoogatMeta::default()
     } else {
