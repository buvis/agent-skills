+#[test]
+fn frontmatter_at_cap_still_parses() {
+    let padding = "a".repeat(MAX_FRONTMATTER_BYTES - "title: ".len());
+    let yaml = format!("title: {padding}");
+    assert_eq!(yaml.len(), MAX_FRONTMATTER_BYTES);
+    let meta = parse_frontmatter(&yaml, "note.md").unwrap();
+    assert_eq!(meta.title.as_deref(), Some(padding.as_str()));
+}
+
+#[test]
+fn frontmatter_over_cap_rejected_with_sizes_in_message() {
+    let yaml = "a".repeat(MAX_FRONTMATTER_BYTES + 1);
+    let err = parse_frontmatter(&yaml, "note.md").unwrap_err();
+    let msg = err.to_string();
+    assert!(msg.contains(&MAX_FRONTMATTER_BYTES.to_string()));
+    assert!(msg.contains(&(MAX_FRONTMATTER_BYTES + 1).to_string()));
+}
