+def notify_result(result: CommandResult, notify: Callable[..., None]) -> None:
+    """Forward a :class:`CommandResult` to a TUI-style ``notify`` callback.
+
+    Every warning is forwarded first with ``severity="warning"``, then the
+    success output with ``severity="information"`` or the failure message
+    with ``severity="error"``. A success with empty output notifies nothing
+    beyond warnings; a failure with an empty error message falls back to
+    ``"Failed"``.
+
+    Args:
+        result: The command result to forward.
+        notify: Callback invoked as ``notify(message, severity=...)``.
+    """
+    for warning in result.warnings:
+        notify(warning, severity="warning")
+    if result.success:
+        if result.output:
+            notify(result.output, severity="information")
+        return
+    notify(result.error or "Failed", severity="error")
