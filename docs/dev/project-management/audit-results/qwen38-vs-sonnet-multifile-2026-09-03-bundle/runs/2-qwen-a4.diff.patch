+class TestNotifyResult:
+    def test_success_output_notified_as_information(self) -> None:
+        notify = MagicMock()
+        result = CommandResult(success=True, output="Created note.md")
+
+        notify_result(result, notify)
+
+        notify.assert_called_once_with("Created note.md", severity="information")
+
+    def test_success_with_empty_output_notifies_nothing(self) -> None:
+        notify = MagicMock()
+
+        notify_result(CommandResult(success=True), notify)
+
+        notify.assert_not_called()
+
+    def test_failure_error_notified_as_error(self) -> None:
+        notify = MagicMock()
+        result = CommandResult(success=False, error="boom")
+
+        notify_result(result, notify)
+
+        notify.assert_called_once_with("boom", severity="error")
+
+    def test_failure_with_empty_error_falls_back_to_failed(self) -> None:
+        notify = MagicMock()
+
+        notify_result(CommandResult(success=False), notify)
+
+        notify.assert_called_once_with("Failed", severity="error")
+
+    def test_warnings_notified_before_success_output(self) -> None:
+        notify = MagicMock()
+        result = CommandResult(success=True, output="ok", warnings=["w1", "w2"])
+
+        notify_result(result, notify)
+
+        assert notify.call_args_list == [
+            call("w1", severity="warning"),
+            call("w2", severity="warning"),
+            call("ok", severity="information"),
+        ]
+
+    def test_warnings_notified_before_failure_message(self) -> None:
+        notify = MagicMock()
+        result = CommandResult(success=False, error="bad", warnings=["w1"])
+
+        notify_result(result, notify)
+
+        assert notify.call_args_list == [
+            call("w1", severity="warning"),
+            call("bad", severity="error"),
+        ]
+
+    def test_success_with_warnings_and_empty_output_notifies_only_warnings(self) -> None:
+        notify = MagicMock()
+        result = CommandResult(success=True, warnings=["w1"])
+
+        notify_result(result, notify)
+
+        assert notify.call_args_list == [call("w1", severity="warning")]
+
