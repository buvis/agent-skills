+#[test]
+fn frontmatter_at_cap_still_parses() {
+    // "key: " (5 bytes) + n 'a's + "\n" (1 byte) == exactly MAX_FRONTMATTER_BYTES
+    let n = MAX_FRONTMATTER_BYTES - 6;
+    let yaml = format!("key: {}\n", "a".repeat(n));
+    assert_eq!(yaml.len(), MAX_FRONTMATTER_BYTES);
+    let meta = parse_frontmatter(&yaml, "20260226120000.md").unwrap();
+    assert_eq!(meta.id, Some(DoogatId("20260226120000".into())));
+    assert!(meta.extra.contains_key("key"));
+}
+
+#[test]
+fn frontmatter_one_byte_over_cap_is_parse_error() {
+    // Same shape as the at-cap case, one byte longer → rejected at the boundary
+    let n = MAX_FRONTMATTER_BYTES - 5;
+    let yaml = format!("key: {}\n", "a".repeat(n));
+    assert_eq!(yaml.len(), MAX_FRONTMATTER_BYTES + 1);
+    let err = parse_frontmatter(&yaml, "ddb/20260226120000.md").unwrap_err();
+    // Ordinary parse error, so the parse-error → MalformedYaml classification carries it
+    assert!(matches!(err, DoogatError::Parse(_)));
+    let msg = err.to_string();
+    // Message names the cap and the actual byte length, both as decimal numbers
+    assert!(msg.contains(&MAX_FRONTMATTER_BYTES.to_string()));
+    assert!(msg.contains(&(MAX_FRONTMATTER_BYTES + 1).to_string()));
+    // Message names the path
+    assert!(msg.contains("ddb/20260226120000.md"));
+}
+
+#[test]
+fn frontmatter_normal_size_unaffected_by_cap() {
+    let yaml = "id: 20260226120000\ntitle: Normal size";
+    let meta = parse_frontmatter(yaml, "20260226120000.md").unwrap();
+    assert_eq!(meta.id, Some(DoogatId("20260226120000".into())));
+    assert_eq!(meta.title.as_deref(), Some("Normal size"));
+}
